DISCORD_TOKEN=
SERVICE_BASE_URL=http://localhost:8080
SERVICE_API_KEY=dev-local-key
LOG_LEVEL=info

# Register slash commands to this guild instead of globally. Guild commands update
# instantly, which is what you want while iterating. Unset it for production.
DISCORD_DEV_GUILD_ID=

# Fallback only. Delivery is driven by the service's notification stream, and this
# covers a stream that dropped quietly or a claim whose lease lapsed.
NOTIFICATION_POLL_INTERVAL=5m

# Port for the liveness endpoint (GET /healthz), for platforms that require one for
# health checks. The bot accepts no other inbound traffic.
PORT=8080
